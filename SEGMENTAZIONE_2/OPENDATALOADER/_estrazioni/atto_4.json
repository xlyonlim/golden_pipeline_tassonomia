    "level" : "4",
    "page number" : 3,
    "bounding box" : [ 56.64, 556.124, 538.798, 568.954 ],
    "font" : "Garamond",
    "font size" : 11.04,
    "text color" : "[0.0]",
    "content" : "✓ ID 6.7 EX ID 12 – RIPRISTINI PUNTUALI DI DISSESTI IN VARIE VIE DEL CENTRO URBANO,"
  }, {
    "type" : "paragraph",
