    "font" : "CourierNewPSMT",
    "font size" : 11.04,
    "text color" : "[0.0]",
    "content" : "“”Richiamate:"
  }, {
    "type" : "list",
    "pdfua_tag" : "L",
    "id" : 43,
    "level" : "2",
    "page number" : 2,
    "bounding box" : [ 54.864, 399.115, 538.613, 635.931 ],
    "numbering style" : "unordered",
    "number of list items" : 4,
    "list items" : [ {
