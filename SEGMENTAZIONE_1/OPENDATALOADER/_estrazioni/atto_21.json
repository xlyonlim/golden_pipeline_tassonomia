    "bounding box" : [ 42.55, 372.621, 294.909, 383.793 ],
    "font" : "ArialMT",
    "font size" : 10.0,
    "text color" : "[0.0]",
    "content" : "Con voti favorevoli ed unanimi espressi nei modi di legge"
