plot_heatmap <- function(mat, titolo, legenda = "r") {
mat_round <- round(mat, 2)
df <- as.data.frame(as.table(mat_round))
names(df) <- c("Var1", "Var2", "Correlazione")
df$Var1 <- factor(df$Var1, levels = rownames(mat_round))
df$Var2 <- factor(df$Var2, levels = rev(colnames(mat_round)))
df$Label <- sprintf("%.2f", df$Correlazione)
df$TextColor <- ifelse(abs(df$Correlazione) > 0.50, "white", "black")
ggplot(df, aes(x = Var1, y = Var2, fill = Correlazione)) +
geom_tile(color = "white", linewidth = 0.4) +
geom_text(aes(label = Label, color = TextColor), size = 3) +
scale_color_identity() +
scale_fill_gradient2(
low = "#756BB1",     # viola: associazioni negative
mid = "grey95",      # neutro
high = "#1B9E77",    # verde: associazioni positive
midpoint = 0,
limits = c(-1, 1)
) +
labs(
title = titolo,
x = "",
y = "",
fill = legenda
) +
theme_minimal(base_size = 11) +
theme(
panel.grid = element_blank(),
axis.text.x = element_text(angle = 45, hjust = 1),
axis.text.y = element_text(size = 9),
plot.title = element_text(face = "bold", hjust = 0.5, size = 12),
legend.title = element_text(face = "bold")
)
}
plot_heatmap <- function(mat, titolo, legenda = "r") {
mat_round <- round(mat, 2)
df <- as.data.frame(as.table(mat_round))
names(df) <- c("Var1", "Var2", "Correlazione")
df$Var1 <- factor(df$Var1, levels = rownames(mat_round))
df$Var2 <- factor(df$Var2, levels = rev(colnames(mat_round)))
df$Label <- sprintf("%.2f", df$Correlazione)
df$TextColor <- ifelse(abs(df$Correlazione) > 0.50, "white", "black")
ggplot(df, aes(x = Var1, y = Var2, fill = Correlazione)) +
geom_tile(color = "white", linewidth = 0.4) +
geom_text(aes(label = Label, color = TextColor), size = 3) +
scale_color_identity() +
scale_fill_gradient2(
low = "#756BB1",     # viola: associazioni negative
mid = "grey95",      # neutro
high = "#1B9E77",    # verde: associazioni positive
midpoint = 0,
limits = c(-1, 1)
) +
labs(
title = titolo,
x = "",
y = "",
fill = legenda
) +
theme_minimal(base_size = 11) +
theme(
panel.grid = element_blank(),
axis.text.x = element_text(angle = 45, hjust = 1),
axis.text.y = element_text(size = 9),
plot.title = element_text(face = "bold", hjust = 0.5, size = 12),
legend.title = element_text(face = "bold")
)
}
