library(ppcor)
library(ggplot2)
plot_heatmap = function(mat, titolo = "", legenda = "r") {
mat_long = as.data.frame(as.table(mat))
colnames(mat_long) = c("Var1", "Var2", "value")
ggplot(mat_long, aes(x = Var2, y = Var1, fill = value)) + geom_tile(color = "white") + geom_text(aes(label = round(value, 2)), size = 3) +
scale_fill_gradient2(
low = "#756BB1",
mid = "white",
high = "#1B9E77",
midpoint = 0,
limits = c(-1, 1),
name = legenda ) +
labs( title = titolo,x = "", y = "" ) +
theme_minimal() +
theme(
axis.text.x = element_text(angle = 45, hjust = 1),
axis.text.y = element_text(size = 10),
panel.grid = element_blank())}
dati_cor_psy = cognition_df[, c( "CognitionZscore","AverageSleep","SleepGap","PoorSleepQuality","NumEarlyClass","DepressionScore","AnxietyScore","StressScore","Happiness","Drinks","ClassesMissed","GPA")]
cor_mat_psy <- cor(dati_cor_psy, method = "pearson")
plot_heatmap(cor_mat_psy,titolo = "",legenda = "Correlazione
globale")
dati_cor_psy = cognition_df[, c("CognitionZscore","AverageSleep","SleepGap","PoorSleepQuality","NumEarlyClass","DepressionScore","AnxietyScore","StressScore","Happiness","Drinks","ClassesMissed","GPA")]
pcor_psy = pcor(dati_cor_psy, method = "pearson")
pcor_mat_psy =pcor_psy$estimate
plot_heatmap(pcor_mat_psy, titolo = "",legenda = "Correlazione
parziale")
# Si crea una copia del dataset per la modellistica
cognition_model = cognition_df
# Predittori numerici da standardizzare
var_scalate = c("AverageSleep","SleepGap","PoorSleepQuality","NumEarlyClass","DepressionScore","AnxietyScore","StressScore","Happiness","Drinks","ClassesMissed","GPA")
# STANDARDIZZAZIONE E ASSEGNAZIONE SUFFISSO "_z"
cognition_model[paste0(var_scalate, "_z")] <- scale(cognition_model[var_scalate])
# RIMOZIONE DELLE V.C NON STANDARDIZZATE
cognition_model = cognition_model[, c("CognitionZscore","AverageSleep_z","SleepGap_z","PoorSleepQuality_z","NumEarlyClass_z","DepressionScore_z","AnxietyScore_z","StressScore_z","Happiness_z","Drinks_z","ClassesMissed_z","GPA_z",
#CATEGORICHE AL DI FUORI DELLA STANDARDIZZAZIONE
"Gender",
"ClassYear",
"LarkOwl",
"AllNighter")]
str(cognition_model)
mod_cog_psy <- lm(CognitionZscore ~ AverageSleep_z + SleepGap_z + PoorSleepQuality_z + NumEarlyClass_z + DepressionScore_z + AnxietyScore_z + StressScore_z + Happiness_z + Drinks_z + ClassesMissed_z + GPA_z + Gender + ClassYear + LarkOwl + AllNighter, data = cognition_model, method = "qr")
summary(mod_cog_psy)
# Diagnostica preliminare modello con sottoscale
par(mfrow = c(2, 2))
plot(mod_cog_psy)
par(mfrow = c(1, 1))
library(lmtest)
library(car)
#controlliamo la normalità
shapiro.test(rstandard(mod_cog_psy))
#per sicurezza, sebbene non ci sia una funnel shape  chiara, la lowess line non è orizzontale e si nota una leggera tendenza ad aumentare sui valori di x più alti
bptest(mod_cog_psy)  #per i valori di x
ncvTest(mod_cog_psy) #per i fitted values
vif(mod_cog_psy) #nessun vif sembra superare essere particolarmente il valore 1
res_std = rstandard(mod_cog_psy)
plot(density(res_std),main = "",
xlab = "Residui standardizzati",
ylab = "Densità",
lwd = 2)
abline(v = 0, lty = 2, lwd = 2)
library(MASS)
n = nobs(mod_cog_psy)
step_psy <- stepAIC(mod_cog_psy,direction = "backward",
k = log(n), #IMPORTANTE PERCHE' DETERMINA LA PENALIZZAZIONE DEL BIC
trace = TRUE)
summary(step_psy)
#COEFFICIENTI FINALI
library(scatterplot3d)
col_gender <- ifelse(cognition_model$Gender == "Male", "darkgreen", "orange")
s3d <- scatterplot3d(
x = cognition_model$StressScore_z,
y = cognition_model$GPA_z,
z = cognition_model$CognitionZscore,
color = col_gender,
pch = 16,
angle = 45,
xlab = "StressScore_z",
ylab = "GPA_z",
zlab = "CognitionZscore",
main = "Modello finale: CognitionZscore ~ StressScore_z + GPA_z + Gender"
)
# Coefficienti del modello finale
b <- coef(step_psy)
# Piano per Female, categoria di riferimento
s3d$plane3d(
b["(Intercept)"],
b["StressScore_z"],
b["GPA_z"],
col = "orange",
lty = 1
)
# Piano per Male: stesso coefficiente di Stress e GPA, intercetta spostata
s3d$plane3d(
b["(Intercept)"] + b["GenderMale"],
b["StressScore_z"],
b["GPA_z"],
col = "darkgreen",
lty = 1
)
legend(
"bottomright",
legend = c("Female", "Male"),
text.col = c("orange", "darkgreen"),
bty = "n"
)
#COEFFICIENTI FINALI
