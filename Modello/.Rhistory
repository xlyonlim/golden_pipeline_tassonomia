low = "#756BB1",
mid = "white",
high = "#1B9E77",
midpoint = 0,
limits = c(-1, 1),
name = legenda ) +
labs( title = titolo,x = "", y = "" ) +
theme_minimal() +
theme(
axis.text.x = element_text(angle = 45, hjust = 1),
axis.text.y = element_text(size = 10),
panel.grid = element_blank())}
