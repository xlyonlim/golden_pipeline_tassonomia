# 2. Funzione heatmap ----------------------------------------
plot_heatmap <- function(mat, titolo, legenda = "r") {
mat_round <- round(mat, 2)
df <- as.data.frame(as.table(mat_round))
names(df) <- c("Var1", "Var2", "Correlazione")
df$Var1 <- factor(df$Var1, levels = rownames(mat_round))
df$Var2 <- factor(df$Var2, levels = rev(colnames(mat_round)))
df$Label <- sprintf("%.2f", df$Correlazione)
df$TextColor <- ifelse(abs(df$Correlazione) > 0.55, "white", "black")
ggplot(df, aes(x = Var1, y = Var2, fill = Correlazione)) +
geom_tile(color = "white", linewidth = 0.3) +
geom_text(aes(label = Label, color = TextColor), size = 3) +
scale_color_identity() +
scale_fill_gradient2(low = "#08306B", mid = "grey55", high = "#FDE725",
midpoint = 0, limits = c(-1, 1)) +
labs(title = titolo, x = "", y = "", fill = legenda) +
theme_minimal(base_size = 11) +
theme(panel.grid = element_blank(),
axis.text.x = element_text(angle = 45, hjust = 1),
plot.title = element_text(face = "bold", hjust = 0.5))
}
dati_cor_das <- cognition_df[, c(
"CognitionZscore", "AverageSleep", "SleepGap", "PoorSleepQuality",
"NumEarlyClass", "DASScore", "Happiness", "Drinks",
"ClassesMissed", "GPA"
)]
dati_cor_das <- na.omit(dati_cor_das)
cor_mat_das <- cor(dati_cor_das, method = "pearson")
print(plot_heatmap(cor_mat_das,
"Heatmap delle correlazioni lineari - DASScore", "r"))
